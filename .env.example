# -----------------------------
# GEML Environment (.env.example)
# Copy to .env and fill in values as needed
# -----------------------------

# GitHub Personal Access Token for cloning private repositories
# Generate a PAT at: https://github.com/settings/tokens
# Required: repo (for private repository access)
GITHUB_PAT=

# Optional: Git configuration for commits
GIT_USER_NAME="GEML Development"
GIT_USER_EMAIL="dev@geml.local"

# Required: repository URL
GIGAVOLVE__REPO_URL="https://github.com/FusionBrainLab/gigaevo-core"
# Optional: checkout specific tag/branch
GIGAVOLVE__REPO_REF=
# Optional: remove existing repo
GIGAVOLVE__REPO_FORCE_REFRESH=false

# Required: LLM configuration
LLM__API_KEY=
LLM__BASE_URL=
LLM__MODEL=
LLM__MAX_TOKENS=2048

# Optional: whether to bypass SSL check inside evolution engine
GIGAVOLVE__SSL_BYPASS_ENABLED=false

# Optional: how often (in seconds) to collect results from running experiments
GIGAVOLVE__RESULTS_COLLECTION_INTERVAL=10