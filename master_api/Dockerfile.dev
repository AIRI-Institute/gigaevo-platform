# syntax=docker/dockerfile:1.7

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONPATH=/app
# Copy instead of hardlink out of the uv cache mount (different filesystem).
ENV UV_LINK_MODE=copy
# Compile .pyc at install time so the first import per container is faster.
ENV UV_COMPILE_BYTECODE=1

# Bring the uv binary in from the official image (no `pip install uv` round
# trip). Kept on python:3.12-slim because this image needs the Debian
# `docker-cli` package, which the uv base image's distro doesn't carry.
COPY --from=ghcr.io/astral-sh/uv:python3.12-bookworm-slim /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

# Install system dependencies, the Docker CLI client, and uv. apt cache mounts
# keep package lists + .debs across rebuilds; lists live in the mount, not the
# image layer.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache \
    && apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    docker-cli \
    gosu

# Copy dependency manifests first so dependency layers survive source-only edits.
COPY master_api/pyproject.toml ./pyproject.toml
COPY master_api/uv.lock ./uv.lock

# Install dependencies; the uv cache mount reuses wheels across rebuilds.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project

# Copy application code after dependency resolution.
COPY master_api/src/ ./src/
COPY master_api/data_examples/ ./data_examples/
COPY master_api/prompt_examples/ ./prompt_examples/
COPY common/ ./common/
# Ship the root pyproject.toml beside common/ so common.version can resolve
# the single-source version at runtime (the package itself isn't installed).
COPY pyproject.toml ./common/pyproject.toml

# Copy entrypoint script
COPY master_api/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

# Create non-root user (run app as this user via entrypoint)
RUN useradd -m -u 1000 gigaevouser && chown -R gigaevouser:gigaevouser /app

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Development mode - will be overridden by docker-compose command
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["uv", "run", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
