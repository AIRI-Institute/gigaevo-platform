FROM python:3.12-slim

WORKDIR /app

# Install system dependencies including development tools
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    git \
    curl \
    gosu \
    && rm -rf /var/lib/apt/lists/* \
    && pip install uv

# Copy application code and pyproject.toml
COPY src/ ./src/
COPY pyproject.toml .

# Install the application using uv
RUN uv sync

# Copy entrypoint script
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

# Create directories for GigaEvolve cloning
RUN mkdir -p /tmp/gigavolve /app/repos && \
    useradd -m -u 1000 gemluser && \
    chown -R gemluser:gemluser /app /tmp/gigavolve

# Don't switch to gemluser here - we'll do it in the entrypoint
# USER gemluser

# Expose port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Development mode - will be overridden by docker-compose command
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8001", "--reload"]