FROM python:3.12-slim

WORKDIR /app

ENV PYTHONPATH=/app:/

# Install system dependencies including development tools
RUN apt-get update && apt-get install -y \
    curl \
    gosu \
    && rm -rf /var/lib/apt/lists/* \
    && pip install uv

# Copy only pyproject.toml during build (app.py will be mounted as volume)
COPY web_ui/pyproject.toml ./pyproject.toml

# Install the application using uv
RUN uv sync

# Copy entrypoint script
COPY web_ui/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Create directories and user (will be adjusted in entrypoint)
RUN mkdir -p /app && \
    useradd -m -u 1000 gigaevouser || true

# Don't switch to gigaevouser here - we'll do it in the entrypoint
# USER gigaevouser

# Expose port
EXPOSE 7860

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:7860 || exit 1

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Development mode - command specified in docker-compose